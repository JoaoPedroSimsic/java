AUTH_PROFILE=prod
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8083
AUTH_COOKIE_DOMAIN=hermes-staging.yourdomain.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
GITHUB_REDIRECT_URI=https://hermes-staging.yourdomain.com/auth/github/callback
AUTH_DB_HOST=auth-db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
AUTH_CACHE_HOST=auth-cache
REDIS_PORT=6379
AUTH_ACCESS_TOKEN_MAX_AGE=300
AUTH_REFRESH_TOKEN_MAX_AGE=1800
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_INTERVAL=5000
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
COGNITO_USER_POOL_ID=us-east-1_yourPoolId
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_DOMAIN_URL=https://hermes-auth-staging.auth.sa-east-1.amazoncognito.com
AWS_DEFAULT_REGION=sa-east-1
