WS_GATEWAY_PORT=8082
GATEWAY_PROFILE=prod
NATS_URL=nats://nats:4222
LOG_LEVEL=info
JWKS_CACHE_TTL=3600
CHAT_SERVICE_URL=http://chat-service:8084
RATE_LIMIT_AUTHENTICATED=200
RATE_LIMIT_AUTHENTICATED_BURST=300
GATEWAY_CACHE_HOST=gateway-cache
REDIS_PORT=6379
CB_SLIDING_WINDOW_SIZE=10
CB_MINIMUM_NUMBER_OF_CALLS=5
CB_FAILURE_RATE_THRESHOLD=50
CB_WAIT_DURATION_OPEN_STATE_SECONDS=30
CB_PERMITTED_CALLS_HALF_OPEN=3
TIME_LIMITER_TIMEOUT_SECONDS=10
CONNECTION_MAX_DURATION_MINUTES=0
COGNITO_JWKS_URL=https://cognito-idp.sa-east-1.amazonaws.com/your-pool-id/.well-known/jwks.json
COGNITO_JWT_ISSUER=https://cognito-idp.sa-east-1.amazonaws.com/your-pool-id
CORS_ALLOWED_ORIGINS=https://hermes-staging.yourdomain.com
