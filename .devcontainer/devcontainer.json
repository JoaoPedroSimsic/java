{
  "name": "hermes-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "hermes",
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.kube\" \"${localEnv:HOME}/.minikube\"",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}/.kube,target=/home/hermes/.kube,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.minikube,target=/home/hermes/.minikube,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "MINIKUBE_HOME": "/home/hermes/.minikube",
    "KUBECONFIG": "/home/hermes/.kube/config"
  },
  "runArgs": [
    "--network=host",
    "--ulimit",
    "nofile=1048576:1048576"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "vmware.vscode-spring-boot",
        "vscjava.vscode-java-pack",
        "golang.go",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
